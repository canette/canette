{
  "name": "@canette/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --target=bun --compile --outfile api-server",
    "build:migrate": "bun build scripts/migrate.ts --target=bun --compile --outfile db-migrate",
    "db:migrate": "bun run scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix --fix-dangerously"
  },
  "dependencies": {
    "@canette/types": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-auth": "^1.7.12",
    "hono": "4.13.13",
    "jose": "^6.2.13",
    "js-yaml": "^5.5.0",
    "kysely": "^0.29.7",
    "pg": "^8.23.1",
    "resend": "^6.34.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.23.1",
    "bun-types": "^1.3.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
