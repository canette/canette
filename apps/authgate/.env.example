# Copy to .env and fill in values before running (bun -e / go run . reads it
# automatically for local dev — never used in the actual sidecar container,
# which gets these as real env vars from the controller).

# Same bcrypt hash format the API stores in apps.password_gate_password_hash,
# e.g. generate one with:
#   bun -e 'console.log(await Bun.password.hash("test123", {algorithm: "bcrypt", cost: 10}))'
#
# No username variable — this gates one shared password, not individual
# accounts. `curl -u anything:test123 ...` works with any username.
#
# MUST be single-quoted: godotenv (used to load this file) does shell-style
# $VAR expansion on unquoted/double-quoted values, and a bcrypt hash's
# $2b$10$... prefix looks exactly like variable references ($2, $10, ...) —
# unquoted, they silently get replaced with empty strings and the hash comes
# out corrupted. Single quotes disable that expansion.
AUTHGATE_PASSWORD_HASH='$2b$10$REPLACE_WITH_YOUR_GENERATED_HASH'

# Port of the "app" this gate sits in front of, e.g. `python3 -m http.server 3000`.
AUTHGATE_UPSTREAM_PORT=3000

# Non-secret, shown as the login page title.
AUTHGATE_APP_SLUG=demo-app

# Address and port to listen on.
AUTHGATE_LISTEN_ADDR=:8081

# Session cookies are Secure by default, so a real browser won't keep you
# logged in when testing over plain http://localhost. Set this to "true" AND
# build/run with -tags=localdev to drop Secure (and the __Host- cookie name
# prefix, which requires it) for local testing only:
#   go run -tags=localdev .
# Without the build tag this variable does nothing — it's compiled out of
# every canette-authgate image, so it cannot be enabled in a real deployment
# by setting it on the container.
AUTHGATE_INSECURE_COOKIES=true
